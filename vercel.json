{
  "buildCommand": "pnpm --filter @workspace/vedhha run build:vercel",
  "outputDirectory": "artifacts/vedhha/dist/public",
  "installCommand": "npm install -g pnpm@10 && pnpm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://RAILWAY_BACKEND_URL/api/:path*"
    }
  ]
}
